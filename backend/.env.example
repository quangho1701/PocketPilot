# Server
PORT=8000
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# CockroachDB
# Local (docker-compose): use the insecure single-node connection
# Production: use the CockroachDB Cloud connection string
DATABASE_URL=cockroachdb+asyncpg://root@localhost:26257/pocketpilot?sslmode=disable

# LLM provider: Gemini is the default no-cost development provider.
# If the key is missing, categorization still works with local fallback rules.
LLM_PROVIDER=gemini

# Google Gemini (free tier — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL_ID=gemini-embedding-001

# AWS Bedrock (optional provider; not required for local development)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSION=1024

# Local receipt OCR (no AWS Textract subscription required)
# Leave TESSERACT_CMD empty when tesseract is available on PATH.
TESSERACT_CMD=
TESSERACT_LANG=eng
RECEIPT_STORAGE_DIR=storage/receipts

# Authentication
AUTH_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CockroachDB Cloud MCP (production only)
COCKROACHDB_CLOUD_API_KEY=
